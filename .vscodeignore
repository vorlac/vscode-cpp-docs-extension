.git/**
.github/**
.vscode/**
.gitignore
.vscodeignore

media/recordings/**
media/icons/extras/**

**/*.map
**/*.ts
**/.DS_Store

src/**
test/**
docs/**
fixtures/**
tsconfig*.json
esbuild.mjs
vitest.config.ts
eslint.config.mjs
scripts/**
package-lock.json

# Trim node_modules cruft (vsce already excludes devDependencies; these
# patterns drop README/CHANGELOG/test fixtures within prod deps).
node_modules/**/*.md
node_modules/**/*.markdown
node_modules/**/CHANGELOG*
node_modules/**/HISTORY*
node_modules/**/README*
node_modules/**/test/**
node_modules/**/tests/**
node_modules/**/__tests__/**
node_modules/**/.bin/**
node_modules/**/*.ts
node_modules/**/*.map
node_modules/**/AUTHORS*
node_modules/**/CONTRIBUTORS*
